# NOTE: .gitignore has no inline comments. A "#" only starts a comment at the
# START of a line — anywhere else it is part of the pattern, which silently
# does nothing and leaves the file tracked. Keep every comment on its own line.

# --- What Wawi records about YOU ---------------------------------------
# This is the section that matters most. Wawi listens to a room and looks at
# a screen; everything below is a recording of that. None of it is source
# code, and committing any of it publishes what was said and seen near the
# machine — to anyone who can read the repository, and it stays in history
# even after a later deletion.

# THE private folder (wawi/paths.py): your config.yaml, every log and
# transcript, what she learned, every *_local.json and *_state.json. Wawi
# keeps everything personal here; back up this one folder. The root-level
# entries below stay so an old checkout that has not moved its files in yet
# is still covered.
private/

# Verbatim transcript of every exchange.
conversation.log
# Standing instructions, in the user's own words.
preferences.txt
# Auto-filed problems; their context quotes what you said.
issues/
# Screen captures taken when no project was named.
screenshots/
# Screen captures dropped into a worktree for an agent to open.
.wawi-shots/
**/.wawi-shots/

# --- Runtime output -------------------------------------------------------
# Covers answers.log too, which is the readable transcript the background
# launcher writes: same content as conversation.log, same reason to keep it out.
*.log
# Written by scripts/wawictl while it runs in the background (jarvis.pid is
# the name it had before the rename).
wawi.pid
jarvis.pid

# --- Local audio artefacts ------------------------------------------------
# Spike and diagnostic scripts write these next to the source.
*.wav

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- Virtualenvs ----------------------------------------------------------
.venv/
venv/
env/

# --- Editors and OS -------------------------------------------------------
.DS_Store
.idea/
*.swp
*~

# --- Local tooling state --------------------------------------------------
.atl/
.claude/
.mcp.json

# --- Secrets ----------------------------------------------------------------
.env
.env.*

# --- Stray images in the project root ----------------------------------------
# Mascot art lives under wawi/assets/; a loose image at the root is a local
# scratch file (or a screenshot) that should never be published by accident.
/*.jpg
/*.jpeg
/*.png

# --- Local configuration --------------------------------------------------
# config.yaml is YOUR machine: min_speech_level is your room's noise floor,
# silence_ms is how long you pause when you think, phrases is what you chose
# to call it. config.yaml.example is the tracked template to copy.
config.yaml

# --- HUD geometry (set by dragging, not by editing) -----------------------
panel_state.json

# Wawi's needs between runs (wawi/pet/needs.py): when you last fed her.
pet_state.json
pet_state.json.tmp

# Durable rolling memory (wawi/recall.py) — a transcript of the room,
# same reason to keep it out as conversation.log.
recall.txt

# Interrupted turn or task (wawi/inflight.py) — it quotes what you asked for.
inflight.json
inflight.json.tmp

# Generated TTS clips used by the noise tests (not a real voice)
!tests/fixtures/*.wav
# Wawi's bark/whine/howl (scripts/make_wawi_sounds.py, or your dog's recordings)
!wawi/assets/sounds/*.wav

# What you asked Wawi to watch by voice ("vigilá example.com"), merged over
# config.yaml's sensors: section — your URLs, ports and city.
sensors_local.json
sensors_local.json.tmp

# Always-on vs wake phrase, as you last switched it by voice or menu.
wake_local.json
wake_local.json.tmp
/*.pdf

# What Wawi learned from you (wawi/learn/): your tastes, and a log of when
# you touched her or brushed her alerts away. Same reason as recall.txt.
learn_state.json
learn_state.json.tmp
learn_brain.npz
learn_brain.npz.tmp.npz
learn_life.jsonl
learn_life.jsonl.tmp

# Your day's rhythm as Wawi sees it (wawi/instinct/): which kind of app was in
# front and when you were at the keyboard, per hour, for 8 weeks. No titles,
# no keystrokes, but still a diary of your working hours: never publish it.
instinct_state.json
instinct_state.json.tmp
# Games against Wawi (wawi/games/): scores, how you throw at
# piedra-papel-tijera, and when you like to play.
games_state.json
games_state.json.tmp

# Wawi's Orca terminal, Run and the coding tasks in flight (wawi/orca.py).
# Task titles and Orca handles: local state, never source.
orca_local.json
orca_local.json.tmp
shortcuts_local.json
shortcuts_local.json.tmp

# Owner's private reminders and routine instructions.
reminders_local.json
reminders_local.json.tmp

# Curiosidades (wawi/curiosities.py): the menu switch, the cached batch and
# the titles already shown.
curiosities_local.json
curiosities_local.json.tmp
# Bailar con música (wawi/music.py): only the menu switch.
music_local.json
music_local.json.tmp

# Local board history and saved HTML.
board_local/

# Agregados (wawi/plugins.py): your services' URLs, commands and endpoints.
# Tokens are never in it (Keychain or env var), but the list itself is yours.
plugins_local.json
plugins_local.json.tmp

# Iniciativa (wawi/initiative/): the menu switches, what she learned about
# which of her own acts you welcome, and when you were last at the keyboard.
initiative_local.json
initiative_local.json.tmp
# Autoarreglo (wawi/selffix/): the menu switch, attempt history and pending
# changes. Issue titles and evidence: local state, never source.
selffix_local.json
selffix_local.json.tmp

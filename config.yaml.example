# Wawi — configuration TEMPLATE
#
# Every key works the same whichever language setting you choose.
#
# Copy this file to private/config.yaml and adjust it to your machine:
#
#     mkdir -p private && cp config.yaml.example private/config.yaml
#     python -m wawi --check
#
# private/ is the ONE gitignored folder that holds everything personal: this
# config, the logs and transcripts, what she learned, every *_local.json. A
# bare file name below (conversation.log, wake_local.json...) lives in
# private/; write a path with a folder in it to put a file anywhere else. An
# older config.yaml at the repository root still works, and the first start
# moves it (and every other personal file left there) into private/.
#
# config.yaml is gitignored on purpose. Several values here are measurements
# of a particular room and a particular voice — min_speech_level is literally
# that room's noise floor, and silence_ms is how long that person pauses when
# they think. Shipping one person's numbers as everyone's defaults would make
# the assistant behave worst for whoever installs it next.
#
# The values below are deliberately CONSERVATIVE, not tuned:
#   min_speech_level: 0.0   -> the amplitude gate is OFF. Turn it on only if
#                              your room needs it:  python scripts/diag_wake.py --measure-noise
#   silence_long_ms:  0     -> no progressive endpointing until you want it.

# Assistant language: "es" or "en". It is NOT just the STT: it moves four
# things together, and that is the point —
#   1. which language Whisper is TOLD it is hearing,
#   2. the language the system prompt asks for,
#   3. the Kokoro voice (as long as tts.voice is "auto"),
#   4. the fixed phrases the assistant says on its own (the connection
#      error, the "I didn't hear you", and which words count as a yes).
# Changing only one leaves you with English answers in a Spanish voice, which
# sounds worse than changing nothing. For a one-off run:  python -m wawi --lang en
language: es

# What the assistant calls itself. Keep it equal to a wake phrase, or it
# introduces itself as something you cannot summon.
assistant_name: Wawi

# Turns of conversation the model can see. Each one is re-sent (and paid for)
# on every later turn, so this buys continuity by the sentence, not by the hour.
memory_turns: 6

# Readable transcript you can follow with:  tail -f private/conversation.log
# Empty string disables it and leaves no file behind.
conversation_log: conversation.log

# Durable rolling memory, so a restart is not amnesia. The last few exchanges
# are written here and re-sent inside the system prompt on every turn of the
# NEXT run — which is the cost: recall_turns exchanges, each side clipped to
# 160 characters, is roughly 200-600 input tokens paid on every single turn.
# Keep it small. This is a transcript of your house on disk: `rm private/recall.txt`
# wipes it, and an empty value below disables it and leaves no file behind.
recall_file: recall.txt
recall_turns: 6

# Picking up where a crash or restart left off. While a turn or a delegated
# task is running it is written here, and erased when it ends. If Wawi dies
# in the middle, the next start asks ONCE "I got cut off while doing…, shall
# I pick it up again?": a yes resumes it, anything else drops it. Closing Wawi
# with nothing running leaves no file and asks nothing. Older than
# resume_max_age_h hours, it is dropped without asking. An empty value below
# disables it and leaves no file behind.
inflight_file: inflight.json
resume_max_age_h: 12

# DANGEROUS, and deprecated. ON now means "yolo" for one hour from startup:
# the executor does risky things (delete, send, pay, git push) without
# asking, then it switches itself off and goes back to asking. It never
# unlocks the blocklist (Keychain, password managers, System Settings, sudo).
# The executor cannot turn this on for itself. Off unless you mean it.
dangerous_skip_permissions: false

# Standing instructions you teach by voice ("be briefer"). Plain text, one
# per line — edit or delete them by hand. Empty string disables it.
preferences_file: preferences.txt

# Where Wawi files problems it notices. It can ONLY write issues here; it has
# no way to edit code. Empty string disables it.
issues_dir: issues
# WARNING: true runs `gh issue create` in the directory Wawi was started
# from. If that is a clone of a PUBLIC repository (this one, for example), each
# issue — including the context, which QUOTES WHAT YOU SAID near the
# microphone — is posted publicly on GitHub under your account. Leave it false
# unless the working directory points at a private repo you own.
issues_to_github: false

models:
  # Measured on this machine, with a warm cache: opus-5 (previously) ~0.0020 USD per
  # short turn vs ~0.0014 for sonnet-4-6. Caches are PER MODEL, so the first
  # turn after changing this costs extra until the cache is rebuilt.
  on_demand: claude-opus-5-5

audio:
  sample_rate: 16000
  push_to_talk_key: cmd_r        # right Command (⌘); hold to talk (fallback path)

# Always-on wake phrase — the primary way in. Push-to-talk still works and
# runs on this same microphone stream, so it gains the pre-roll for free.
wake:
  enabled: true
  # openwakeword: pretrained model, six English phrases only, ~1.4ms per chunk.
  # whisper:      transcribes each speech segment and matches `phrases`, so the
  #               trigger can be any word in any language, ~40ms per segment.
  engine: whisper
  # false = always listening (default): anything the VAD recognizes as speech
  #         opens a turn. No trigger model is loaded. The echo of her own
  #         voice is still discarded and the panel switch closes the
  #         microphone, but any conversation nearby is a paid turn.
  # true  = you have to say her name ("wawi") for her to answer.
  # With engine: openwakeword + require_phrase: true the trigger is
  # openWakeWord's pretrained "hey jarvis" model (English only, weights under
  # CC BY-NC-SA 4.0 — non-commercial). With the defaults it is never loaded.
  # Change it live by voice ("Wawi, use the wake word" / "always listen") or
  # from the menu. That choice is saved in local_file and overrides this value on start.
  require_phrase: false
  phrases: ["wawi"]           # any of these wakes her (if require_phrase)
  # Other ways Whisper spells the name, compared EXACTLY (the built-in ones
  # are in wawi/wake.py: guagui, guaui, waui, wowie...). Never add common
  # words ("guau", "agua", "bueno"): they would wake her.
  aliases: {}                 # e.g. {wawi: ["guaguí"]}
  # Hint for the trigger's Whisper. auto = "Wawi, Wawi.": without it
  # whisper-tiny writes "Wavis"/"Wabies" and misses the name (1.7 % vs
  # 97.5 %, measured). "" = no hint: stricter and much more deaf.
  whisper_prompt: auto
  # Seconds of speech scanned for the name. If it is not there, the rest of
  # that talk is ignored without transcribing. 0 = scan the whole segment.
  window_s: 1.5
  # With engine: openwakeword: "" = pretrained "hey jarvis"; wawi = the custom
  # model in wawi/assets/wakeword/wawi.onnx (scripts/wakeword/README.md).
  # If the file is missing, it falls back to whisper mode.
  model: ""
  # Second opinion in whisper mode: the trained acoustic model has to score
  # >= verify_threshold. Cuts false wakes on "Huawei", "Wally", "guau" from
  # ~50 % to ~5 % (measured), at the cost of ~3 points of detection. "" = Whisper
  # only (try it if she doesn't recognize you: it has never heard your voice).
  verify_model: wawi
  verify_threshold: 0.5
  patience: 1            # openwakeword engine: consecutive frames (2 with 0.8 = fewer false wakes)
  local_file: wake_local.json   # where the mode chosen by voice/menu is kept
  whisper_model: mlx-community/whisper-tiny-mlx
  pre_roll_s: 1.5        # audio kept from BEFORE the trigger, so "Wawi,
                         # what broke?" said in one breath is not clipped
  # Endpointing grows with how much you have said: snappy for a command,
  # patient for an explanation. Once you have been talking for 8s you are
  # clearly explaining something rather than giving an order, so it lets you
  # pause 5s to think.
  silence_long_ms: 0
  long_after_s: 8.0
  silence_ms: 1200       # silence that ends an utterance. This is a DIRECT
                         # trade: lower feels snappier, higher lets you pause
                         # to think without being cut off. You pay it twice —
                         # once waiting after you stop, once when it truncates.
  # Smart end of turn: after smart_turn_pause_ms of silence, a model
  # (Pipecat's Smart Turn v3.2, local, ~15 ms) listens for whether the sentence
  # SOUNDED finished. If so, it cuts there; if not, it keeps waiting up to
  # silence_ms, which becomes the ceiling. The trade-off: when it is right it
  # saves you almost all of silence_ms; when it is wrong it cuts you off
  # mid-thought (Pipecat measures ~7% false "finished" in Spanish). Model
  # missing or failing -> behaves as before. Download it once (~32 MB):
  #   python -c 'from wawi.turn import download_model; download_model()'
  smart_turn: false         # true after downloading the model (see above)
  smart_turn_threshold: 0.5  # P(finished) needed to cut; HIGHER = fewer cuts
                             # mid-thought, fewer fast turns
  smart_turn_pause_ms: 300   # when to ask it. Measured: 150-300 makes no difference;
                             # with more silence the model leans towards "finished"
                             # (at 600 ms it only catches 3/10 cut-off sentences; at 1 s, 0/10)
  max_utterance_s: 30.0  # hard cap, so a noisy room cannot record forever
  # Walkie-talkie: after Wawi answers, the channel stays open only when a
  # reply is actually expected. It decides from its own answer — a question or
  # a pending confirmation waits, a plain statement closes and you need the
  # wake phrase again. The panel says "tu turno" (your turn) while the channel is open.
  # true = continuous conversation: the channel stays open after EVERY answer,
  # and the wake phrase is only needed to resume if you stopped. false = it only
  # waits when it asked you a question.
  conversation_mode: true
  follow_up_s: 10.0      # grace to START replying. NOT a cap on your answer:
                         # once you start talking it records until silence_ms,
                         # however long you take.
  follow_up_idle_s: 0.0  # window after a plain statement (0 = close at once)
  vad_threshold: 0.5     # speech probability; higher is stricter
  # Noise filter, BEFORE transcribing. A segment only opens after min_onset_ms
  # of frames the VAD scores >= vad_onset_threshold within onset_window_ms
  # (a clap, a keystroke or a slammed door is 1-2 frames of 30 ms), and it is
  # dropped without going through Whisper if it doesn't collect min_voiced_ms
  # of voice or if the voice is too patchy (min_voiced_ratio). Each drop is
  # logged in wawi.log as "Dropped segment as noise: <reason>", for tuning.
  # Still triggering on noise? Raise vad_onset_threshold (0.7) or
  # min_onset_ms (210). Is a short "yes" getting cut? Lower min_voiced_ms (180).
  vad_onset_threshold: 0.6  # higher than vad_threshold: hard to start, easy to keep going
  min_onset_ms: 150
  onset_window_ms: 400
  min_voiced_ms: 250
  min_voiced_ratio: 0.2
  barge_in: false        # OFF: the mic is closed while Wawi talks, so it can
                         # never hear itself. Interrupt it with the key
                         # (cmd_r), which needs no echo cancellation.
                         # true = interrupt by voice, at the cost of keeping
                         # the microphone open while it talks.
  min_speech_level: 0.0  # peak amplitude a frame must ALSO reach to count as
                         # speech. The VAD scores speech-LIKENESS, not loudness,
                         # so room noise can score 0.9+ on near-silent audio and
                         # the utterance then never ends. Measure yours with:
                         #   python scripts/diag_wake.py --measure-noise
  wake_threshold: 0.5    # wake score; HIGHER = less eager (fewer false wakes)

stt:
  engine: mlx-whisper
  model: mlx-community/whisper-large-v3-turbo
  # Junk filter, AFTER transcribing. Whisper given noise does not return
  # nothing: it invents "Gracias." ("Thanks."), "¡Suscríbete al canal!"
  # ("Subscribe to the channel!") or repeats phrases from the initial prompt.
  # That is dropped unless the audio had real voice (junk_min_voiced_ms) and
  # Whisper is confident (junk_min_logprob). "sí", "no", "dale" and other
  # short answers are never thrown away by this.
  # Each drop is logged as "Dropped transcript as junk: <reason>".
  filter_junk: true
  min_avg_logprob: -1.0       # below this, always dropped (Whisper guessing)
  max_compression_ratio: 2.4  # above this, Whisper is repeating itself in a loop
  max_no_speech_prob: 0.6
  junk_min_voiced_ms: 700
  junk_min_logprob: -0.45
  # Seeds Whisper's decoder. Leave empty to use the sample written for the
  # active language, which is what steers accents ("s\u00ed", not "si").
  # Set it only to add vocabulary this project keeps getting wrong, and
  # write it the way you want the output written -- accents included.
  initial_prompt: ""

# What Wawi sees when it looks at your screen (the see_screen tool). Only
# the latest capture travels to the model: after a turn that looked, the next
# one starts a fresh session carrying the conversation as text plus a one-line
# note per old capture. 1280 on the long edge is ~1,370 tokens per image at
# 16:10 (1568 was ~2,050, and the server rescales past ~1.15 MP anyway).
# Raise max_edge only if it misreads small text. Does NOT affect the file
# saved when you ask for a screenshot, which keeps its own resolution.
screen:
  monitor: 1
  max_edge: 1280
  jpeg_quality: 65

tts:
  # "auto" = the voice that matches the language above (es -> ef_dora,
  # en -> af_heart). An explicit value ALWAYS wins: if you wrote em_alex it
  # is because you wanted it. Of the model's 54 voices only 3 are Spanish
  # (ef_dora, em_alex, em_santa); the rest are English.
  # It also accepts a weighted MIX of voices: "ef_dora:0.7,af_heart:0.3".
  # That mixes the timbre; the pronunciation is still the language's (es).
  voice: auto
  speed: 1.05  # synthesis speed multiplier (1.0 = normal, 1.05 = slightly faster, reduces perceived latency)
  # Voice character (optional; without these keys it sounds as always).
  # preset: cachorra  -> small puppy voice: ef_dora:0.7,af_heart:0.3, +4 semitones,
  #                      brightness 0.2. Anything you write below (or in voice) beats the preset.
  # pitch_semitones: 4   # raises the pitch without changing duration (+3..+5 sounds younger; >+6 is cartoonish). ~1 ms per sentence.
  # brightness: 0.2      # a touch more treble, 0..1 (0 = off)
  # Start speaking as soon as the first sentence is ready, without waiting for
  # the whole answer to be written. With false you go back to waiting in
  # silence until the end (measured: 19s of silence on a turn with no tools).
  # Note: with streaming, wake-phrase barge-in is off for that turn — the
  # microphone is paused while it speaks. The keyboard still interrupts.
  streaming: true
  # voices_dir: ~/.local/share/kokoro  # uncomment to override default (dir with kokoro-v1.0.onnx + voices-v1.0.bin)

ui:
  show_tui: false      # terminal TUI off — the floating HUD replaces it
  show_panel: true     # floating window with the audio spectrum
  mascot: true         # Wawi beside the panel, moves with the state (needs show_panel)
  # Wawi alone, without the panel: the panel starts hidden on every launch and
  # she stands in a corner (draggable; remembers where you left her).
  # Right-clicking her opens the same menu as the menu bar icon.
  mascot_only: false
  sound_cues: true

# Local visual whiteboard. Interactive HTML works offline by default.
board:
  allow_network: false

# "Wawi, tomá nota" ("Wawi, take a note"): listens without the wake word and
# writes everything it hears to a Markdown file, without going through Claude,
# until "Wawi, pará" ("Wawi, stop"), the STOP button or the menu.
notes:
  dir: ~/Documents/Wawi/Notas   # one file per note: "YYYY-MM-DD HH-MM.md"
  idle_stop_min: 30             # stops on its own after this much silence

# The "Wawi investiga" (Wawi investigates) drop box: a small floating window
# where you drop things (a screenshot, files, links, text) and TYPE what to do
# with them. Double-click to type to her without dropping anything. The
# "Buzón" menu item turns it on and off (that wins).
inbox:
  enabled: true

# Wawi's body: hunger, thirst, sleep, boredom and affection (they drop slowly
# over hours, she never "dies"), life on the desktop, and reactions to what the
# sensors notice. Food, water and ball from the menu (right-click her or the
# menu bar icon). With enabled: false you get the plain mascot as before.
pet:
  enabled: true
  # Who she is: a personality from the personalities/ folder (a name or the
  # path to a file). She lives like a real dog: rests almost all the time
  # (long naps, lying down watching you out of the corner of her eye), gets up
  # for a while every so often, greets you according to how long you were
  # away, and plays only when there is a reason.
  # Built-in ones: perra_tranquila (calm dog, default), perra_atenta (attentive
  # dog), cachorra (puppy). See personalities/README.md to make your own; you
  # can also switch from the menu or by voice, and that choice wins over this.
  # Gestures based on the frontmost app look only at the app's NAME, never at
  # window titles or content.
  personality: perra_tranquila
  # Old shortcut (if you don't set personality): calm = perra_tranquila,
  # normal = perra_atenta, playful = cachorra.
  liveliness: calm
  state_file: pet_state.json   # her needs between runs (not versioned)
  # On her own (panel hidden) she walks along the bottom edge and along the
  # tops of windows, climbs, and falls if you move the window. She only moves
  # somewhere else when she gets up (never while asleep), and prefers lying
  # down near you. Never over full-screen apps or with "Reduce motion".
  wander: true
  wander_every_min: [8, 25]    # at most one change of place per this many minutes
  # Ignored for this long (no talking to or touching her) while you type: she
  # comes to sit by the text cursor to watch. 0 turns it off. She reads no
  # keys: she only knows HOW LONG ago you touched one.
  lonely_after_min: 30
  gravity_on_drop: true        # if you drop her in mid-air, she falls onto whatever is below
  bubbles: true                # little text bubbles for reactions
  sounds: true                 # short barks if there is a file in wawi/assets/sounds
  # bark.wav / whine.wav / howl.wav ship synthesized and quiet
  # (scripts/make_wawi_sounds.py). To use YOUR dog: record it and overwrite
  # those files with the same names. They stay silent in meetings and quiet hours.

# Delegated work: a SECOND agent, with real tools, driven by the
# conversational one. Wawi is still the one who listens and speaks — the
# executor never touches the microphone or the voice. Everything it wants to
# say goes through a mailbox, and Wawi decides when it reaches you.
#
# OFF by default, on purpose: it is the only thing in Wawi that can run a
# command. Permissions are tiered (wawi/guards.py), enforced in code, not in
# the prompt:
#   read (ls, cat, mdfind, open -a, git status, Read/Glob/Grep)  -> never asks
#   ordinary project work (edit, mkdir, pytest...)               -> asks once,
#                                    and the "yes" covers that task for grant_minutes
#   risk (delete, send, pay, transfer, git push, overwrite a file,
#         write outside the project)                              -> ALWAYS asks,
#                                    briefly ("¿Lo mando?" / "Shall I send it?")
#   fixed blocklist (Keychain, 1Password, Bitwarden, System Settings, sudo,
#         this config.yaml)                                       -> denied without asking
# If you don't answer, it is denied automatically. See wawi/task.py.
tasks:
  enabled: false
  cwd: ""              # where the executor works. Empty = where Wawi was started.
  # The real blast radius of this whole feature. Dropping Bash and Write is what
  # actually shrinks it -- start read-only and widen once you trust it.
  # WHAT THE APPROVAL GATE ACTUALLY COVERS -- measured, not assumed:
  #   Bash                          -> asks. Denying it really does stop the
  #                                    command (verified with a canary file).
  #   Read outside this cwd         -> asks.
  #   Read inside cwd, Grep, Glob   -> DO NOT ask. The CLI treats read-only
  #                                    in-workspace access as needing no
  #                                    permission and never consults us.
  # So the list below is the real blast radius, not the voice approval. Drop
  # Bash, Write and Edit and nothing here can change a file or run a command.
  tools: [Bash, Read, Write, Edit, Glob, Grep]
  ask_timeout_s: 300.0       # how long a QUESTION waits before the executor decides alone
  approval_timeout_s: 120.0  # how long a PERMISSION waits before it is denied
  grant_minutes: 30.0        # a "yes" to ordinary work covers that same task this long (0 = ask every time)

# Connectors: the MCP servers you already use in Claude Code (~/.claude.json,
# the .mcp.json in the folder you start Wawi from) or in Claude Desktop, reused
# as they are. They are READ, never written, and each one stays OFF until you
# name it here with the same name it has in that app. Secrets (env, headers)
# are passed to the server and nothing else: not the log, the panel or the voice.
# See wawi/connectors.py.
#
#   mode: read_only  -> "read only". Only tools the server marks readOnlyHint
#                       AND that are in read_tools run. If either is missing,
#                       the tool is not there: it fails closed, not open.
#   mode: read_send  -> "read and send". Reads run without asking; anything
#                       else Wawi reads back to you ("I'm going to send Juan...
#                       shall I send it?") and it only goes out if your next
#                       answer starts with a yes. Anything else, or 2 minutes
#                       of silence: nothing.
#
# trust_read_tools: true -> trust read_tools even if the server does not mark
#                           readOnlyHint (mcp-obsidian doesn't: without this,
#                           even listing notes asks for a yes).
# read_tools is the curated list of reads. If omitted, it uses the sample list
# Wawi ships for three community MCP servers (obsidian, engram and codegraph,
# by the names they are usually registered under); for any other server, none.
# Each enabled server adds its schemas to every turn: enable only a few.
# http servers with an OAuth login in Claude Code don't bring the token along:
# those can't connect from here.
connectors: {}
#  obsidian:
#    enabled: true
#    mode: read_send
#    trust_read_tools: true
#  linear:
#    enabled: true
#    mode: read_send
#    read_tools: [list_issues, get_issue, list_projects]

# Brain backend: "claude" (default, uses claude-agent-sdk subscription auth)
# or "ollama" (local model via Ollama — no cost, no API key required).
# Override for a single run with:  python -m wawi --backend ollama
backend: claude

# Ollama settings (only used when backend: ollama)
ollama:
  model: gemma3:4b          # must be pulled first: ollama pull gemma3:4b
  url: http://localhost:11434/api/chat  # default Ollama endpoint

# --- Sensors: what Wawi watches on her own (wawi/sensors/) -------------------
# With "sensors: {}" (or no section at all) a safe default set starts that
# needs nothing from you and doesn't go online: system (disk + battery) and
# clock (times of day + "time for a break?"). If you name any sensor here,
# only the ones you name are used. "defaults: false" removes the default ones
# and "enabled: false" turns everything off. Weather, websites and news wait
# until you give them a city or a URL.
#
# You can also configure it by talking: "Wawi, watch example.com", "stop
# watching X", "what are you watching?", "tell me the weather in Rosario",
# "watch port 3000 / the api container / the postgres process", "add this
# feed <url>". What you ask for by voice is saved in sensors_local.json (next
# to this file, not versioned) and applied ON TOP of this section, right
# away and without restarting; this file is never rewritten. Delete
# sensors_local.json to go back to what this file says.
#
# Each sensor runs in its own thread,
# with short timeouts; if one fails, it retries with growing back-off and
# doesn't hold up the others. They only notify when something CHANGES (went
# down / came back), never on every check. "interval" (seconds) changes how
# often it looks. With any sensor on, Wawi can also answer "how is everything?".
sensors: {}
#  web:                        # are your websites responding?
#    enabled: true
#    urls: [https://example.com, https://example.org/health]
#    interval: 120
#    timeout: 10
#    fail_after: 2             # down = 2 checks in a row with no response or a 5xx
#  system:                     # disk, battery, memory, CPU
#    enabled: true
#    volumes: ["/"]
#    disk_low_pct: 10          # warning below 10 % ...
#    disk_low_gb: 10           # ... or below 10 GB free
#    disk_critical_pct: 3      # alarm below 3 %
#    battery: true
#    battery_low_pct: 20
#    memory: false             # uses `memory_pressure`
#    cpu: false                # sustained load and temperature (`pmset -g therm`)
#  services:                   # local processes, ports and containers
#    enabled: true
#    processes: [postgres]
#    ports: ["localhost:3000", 5432]
#    docker: true              # true = every one it saw running; or a list
#  weather:                    # Open-Meteo: free, no API key
#    enabled: true
#    city: Buenos Aires        # or lat: -34.6 / lon: -58.38
#    rain_threshold: 60        # % probability for "it's going to rain"
#    rain_hours: 3             # looking this many hours ahead
#    hot_c: 30
#    cold_c: 5
#  rss:                        # new headlines (the first read doesn't notify)
#    enabled: true
#    feeds:
#      - https://example.com/feed.xml
#      - {url: https://example.org/atom.xml, name: Blog}
#  clock:                      # times of day and "time for a break?"
#    enabled: true
#    dayparts: {morning: "08:00", lunch: "13:00", evening: "19:00", late_night: "00:30"}
#    long_session_h: 2         # suggests a break after 2 h of nonstop use
#    break_idle_min: 5         # 5 min without touching anything counts as a break
#  # Your own plugins: each ~/.wawi/plugins/*.py that exposes SENSOR or
#  # make_sensor(config). It is Python code that runs inside Wawi: that is why
#  # it is off. See the docstring of wawi/sensors/__init__.py.
#  defaults: true              # false = no automatic system/clock
#  local_file: sensors_local.json   # where voice requests are saved
#  user_plugins: false
#  plugins_dir: ~/.wawi/plugins
#  plugins:
#    hello: {interval: 3600}

# --- Reflexes: how Wawi reacts to what the sensors notice -------------------
# (wawi/reflexes.py). There are default rules (website down -> firefighter
# helmet and a bark; disk full -> digs; rain -> umbrella...). Each one can be
# changed field by field or turned off with false. Fields: behaviour, costume,
# sound, bubble (with {fields} from the event), speak, priority (0-3), duration,
# until_key, cancel_key, batch, batch_bubble.
# Interruption budget: a per-hour maximum by severity, news grouped together,
# and quiet mode with a full-screen app, in a meeting (Zoom, Teams, FaceTime,
# Webex; a meeting in the browser is not detected) or during quiet hours.
# Only urgent things break the silence, without speaking, and without sound
# if you are in a meeting.
reflexes: {}
#  quiet_hours: "23:00-08:00"
#  quiet_fullscreen: true
#  quiet_meetings: true
#  budget: {info: 3, notice: 6, warning: 10, urgent: 30}   # per hour
#  batch_minutes: 20           # at most one news bubble every 20 min
#  # Spoken reactions (speak: true on a rule, or the mind): Wawi says the
#  # bubble out loud ONLY when all is calm: never over a conversation
#  # (it waits for it to end; if more than speak_stale_s passes, it drops it),
#  # never in quiet mode, and without hearing herself (the microphone is
#  # paused just like when she answers; barge_in is respected).
#  speak_reactions: true
#  speak_per_hour: 4           # at most 4 spoken sentences per hour
#  speak_stale_s: 60
#  # The morning greeting builds a sentence from what the sensors already know
#  # ("Good morning. 24° today, all your websites are up."), without calling
#  # any model. By default only in the bubble; true = she also says it.
#  speak_morning: false
#  rules:
#    web.down: {sound: null}   # no bark
#    weather.sunny: false      # don't notify on sunny days
#    rss.item: {batch_bubble: "Llegaron {count} noticias"}

# Wawi's mind (wawi/mind/). Almost everything works with rules; this adds a
# bit of judgement at the right moment. Everything is optional and can be turned off.
mind:
  enabled: true
  # fetch_page ("go look at this page") and whats_new ("what's new?"), plus
  # pet_* and sensors_status if those modules exist. Each tool adds its schema
  # to EVERY turn: false removes them.
  tools: true
  # Small local model for bubbles with personality and alert triage.
  # "none" = nothing is downloaded: bubbles from a curated list and rule-based
  # triage. To turn it on:  pip install mlx-lm  and for example
  #   local_model: mlx-community/Qwen3-1.7B-4bit   (~1 GB, Apache-2.0)
  # Smaller ones, measured on this Mac and NOT recommended for bubbles:
  #   mlx-community/Qwen3-0.6B-4bit        (~350 MB, Apache-2.0: broken Spanish)
  #   mlx-community/gemma-3-270m-it-4bit   (~190 MB, Gemma terms of use:
  #                                         blazing fast but writes nonsense)
  # With backend: ollama, local_backend: auto uses Ollama with that tag.
  local_model: none
  local_backend: auto        # auto | mlx | ollama
  local_timeout_s: 4
  bubbles: true              # one bubble every 10-20 minutes, never in quiet mode
  bubble_min_interval_s: 600
  bubble_max_interval_s: 1200
  triage: true
  # Events that can wake Claude (rate-limited). Never the "info" ones.
  claude_events: [web.down]
  claude_model: ""           # empty = models.on_demand
  claude_min_interval_s: 600 # one per site every 10 minutes
  claude_max_per_hour: 6
  # fetch_page won't open addresses on your local network (router, localhost)
  # unless you set true.
  fetch_allow_private: false

# What Wawi learns about you (wawi/learn/). Tiny models, numpy only: no LLM,
# no GPU, no downloads. Runs in the background and costs almost nothing.
# What it learns is kept in learn_state.json, learn_brain.npz and learn_life.jsonl
# (ignored by git: they record when you touch her and which alerts you dismiss).
learn:
  enabled: true
  # Which tricks you like: if within reward_window_s you click her, pet her
  # or talk to her, it counts in favour; if you drag her or hide her, a little
  # against. It only tilts the dice (x0.5 to x2): it never removes a trick.
  behaviours: true
  # Which alerts matter to you. Clicking the bubble as soon as it appears =
  # "not interested"; info/notice alerts you always dismiss get batched for
  # later. Urgent ones always get through.
  alerts: true
  reward_window_s: 20
  dismiss_quick_s: 4
  factor_min: 0.5
  factor_max: 2.0
  half_life_days: 21         # old data weighs half every 3 weeks: tastes change
  batch_below: -0.45
  # News: your topics, in your words. A matching headline gets its own
  # bubble; the rest go into the "You have N news items" summary.
  interests: []              # for example: ["AI", "programming", "Python"]
  relevance: true
  # Optional static embeddings (MIT, ~530 MB download, ~130 MB in
  # memory). Only used if you install  pip install model2vec ; without it,
  # keywords + what it learned from your clicks. "none" turns them off.
  embed_model: minishlab/potion-multilingual-128M
  own_bubble_above: 0.7
  drop_below: 0.2            # only when confident (embeddings or learned data)
  # The little brain: a tiny neural network (numpy) that learns your schedule.
  # It trains itself when the computer is idle, every few hours, in seconds
  # of CPU. Until brain_min_samples decisions it barely has a say, and it
  # never weighs more than brain_max_weight: the rules always win.
  brain: true
  brain_min_samples: 300
  brain_max_weight: 0.5
  retrain_every_h: 12
  retrain_idle_s: 600
  life_log_days: 30
  life_log_max_bytes: 2000000

# Her instincts (wawi/instinct/): every now and then Wawi does something on her
# own depending on how your day is going -- greets you when you come back,
# curls up nearby while you focus, brings you the ball when you've skipped your
# break, asks whether you've eaten at your usual time, yawns if you're still at it at 2am.
# Almost always she decides to do NOTHING, and learns (with learn:) which ones you like.
#
# PRIVACY: she only looks at WHAT KIND of app is in front (editor, terminal,
# chat, meeting... from the app's name; never window titles or anything on
# screen) and WHEN you touch the keyboard or mouse (seconds since the last
# key, never which key). Only per-hour-of-day totals are stored in
# instinct_state.json, on this computer, for 8 weeks at most. None of this is
# sent anywhere: not to Claude either, unless you ask Wawi something ("what do
# you know about me?") and the answer needs it. The optional local model
# (mind.local_model) reads it for its bubbles, without leaving the computer.
# "Wawi, forget what you learned" wipes it all (and the learn: data too).
instinct:
  enabled: true
  observe: true              # false = doesn't watch the computer; only her own instincts (hunger)
  sample_s: 30               # how often she looks (seconds)
  decide_s: 120              # how often she considers doing something
  keep_days: 56              # rolling history: 8 weeks
  idle_after_s: 120          # no keyboard or mouse for this long = you're away
  quiet_meetings: true       # in a meeting, nothing at all
  min_gap_min: 20            # minimum time between two instincts
  speak: false               # instinct bubbles are not said out loud
  # Turn individual instincts on or off (all on by default):
  instincts:
    welcome: true            # you're back after 45+ min: "You're back!"
    focus_company: true      # 20+ min focused: curls up nearby, no bubble
    focus_done: true         # you finished a 50+ min block: celebrates
    break_ball: true         # you've gone past your usual break rhythm: brings the ball
    late_night: true         # later than usual: "Still going? It's 2am."
    frenzy: true             # jumping from app to app nonstop: side-eyes you (rare)
    hungry: true             # she's hungry and you're here: asks for food
    lunch: true              # your lunch time and you haven't stopped: "Have you eaten?"
    noticed: true            # you do your usual thing at your usual time: "as always"
  # Minutes before repeating each one (these are some of the built-in ones):
  cooldowns:
    welcome: 120
    break_ball: 90
    late_night: 180
  # Apps it misclassifies: app name (or bundle id) -> category
  # (code, terminal, browser, chat, meeting, music, design, mail, calendar,
  # writing, files). Unknown ones are learned as "other:<name>".
  categories: {}             # for example: {"Linear": "writing", "Cursor": "code"}

# Games with Wawi (wawi/games/): rock-paper-scissors, tic-tac-toe, guess the
# number (the other way round too), fetch, hide-and-seek and dog trivia.
# By voice ("let's play rock, paper, scissors", "rock", "higher", "enough"),
# by clicking her bubble, or from the "Jugar" (Play) menu. Scores, your habits
# at rock-paper-scissors and which games you like are kept in games_state.json
# (outside the repo, in .gitignore).
games:
  enabled: true
  # Let her propose a game on her own. Never in meetings, full screen or quiet
  # hours, never while you're typing and never if nobody is there.
  propose: true
  propose_every_min: 45      # minimum time between one proposal and the next
  max_proposals_per_day: 4
  proposal_timeout_s: 25     # no answer = "no" (and she learns from it)
  bored_below: 45            # she proposes if her fun (0-100) drops below this…
  after_break_min: 10        # …or if you come back from a break at least this long
  focus_typing_s: 45         # typed more recently than this = you're focused
  away_after_min: 15         # no keyboard for longer than this = nobody is there
  speak_proposals: false     # besides the bubble, say it out loud
  tictactoe_level: normal    # facil | normal | dificil (easy | normal | hard; on hard you can't win)
  rps_first_to: 3            # rock, paper, scissors: first to 3 wins
  fetch_max: 6               # balls before she gets tired
  hide_seconds: 90           # hide-and-seek: she comes out on her own after this
  trivia_questions: 5

# Orca tasks (wawi/orca.py): when a feature or a fix comes up while chatting
# with Wawi, "send it to Orca" makes her write the task, summarize it for you
# and ask "shall I send it to Orca?". Only after your "yes" (read from what you
# said, not from what the model decides) does an Orca agent start in its own
# worktree, and Wawi tells you when it finishes, asks something or fails.
# "How are the tasks going?" tells you the status. Needs the Orca app open; if
# it can't find the CLI it turns itself off. Wawi's terminal in Orca, its Run
# and the tasks in progress are kept in orca_local.json, and each task sent in
# issues/<task>.md (both outside the repo, in .gitignore).
orca:
  enabled: true
  cli: ""                    # "" = the one on PATH or the one in /Applications/Orca.app
  agent: claude              # Orca agent that does the work (claude, codex…)
  default_repo: ""           # "" = Wawi's repo; another repo is named by voice
  worktree: new-top-level    # a new worktree per task (or current, path:/…)
  terminal_handoff_enabled: true  # visible terminal without Run/Task; agents and sends ask for confirmation

# macOS Shortcuts by voice. An empty `allow` permits all of them; the ones in
# `confirm` wait for your next "yes" before running. Never run on the model's
# own confirmation. The list is cached for five minutes in an ignored local file.
shortcuts:
  enabled: true
  allow: []
  confirm: []
  local_file: shortcuts_local.json

# Her computer (wawi/webvm/): a Chromium browser in Docker on a Docker host on
# your network that she drives to browse FOR you: "find me flights to Córdoba
# for Friday". While browsing she sits with her laptop and a small window with
# her computer's screen appears next to her (with a button to enlarge it and
# take control). Before logging in, buying, paying, sending messages, posting
# or entering personal data she asks you; she never types passwords.
# Built once with `scripts/wawictl webvm build`; it starts by itself when
# needed and shuts down after idle_stop_min without use. The secrets (API token
# and VNC password) are generated by her and kept in the Keychain ("wawi-webvm").
webvm:
  enabled: false
  context: miserver          # docker --context of the machine that runs it
  host: 192.168.1.50         # its IP on your network (where the ports are published)
  ssh_host: miserver         # ssh alias, for `wawictl webvm build` (rsync + ssh)
  remote_dir: ~/work/wawi-webvm
  api_port: 6180             # control API (with token)
  view_port: 6181            # noVNC (with VNC password)
  image: wawi-webvm:1
  idle_stop_min: 15
  max_steps: 20              # web steps per voice turn
  memory: 2g
  cpus: "2"
  shm_size: 1g
  locale: es-AR
  timezone: America/Argentina/Buenos_Aires
  persist_profile: false     # true = cookies across sessions (volume wawi-webvm-profile)
  allow_lan: false           # true = can open addresses on your network
  ask_before: [login, purchase, payment, message, post, personal_data]
  show_view: true

# Local reminders and routines. Times use this Mac's time zone.
# Reminders you asked for speak even in quiet mode; they wait until Wawi has
# finished listening to you or speaking before interrupting.
reminders:
  enabled: true
  local_file: reminders_local.json  # next to config.yaml; not committed to the repo
  poll_s: 1                       # scheduler clock frequency
